#include<stdio.h>

void contador_regressivo(int n){
// Caso Base
    if(n==0) {
    printf("FIM!\n"); return;
    }
// Caso recursivo
printf("%d\n", n);
contador_regressivo(n - 1);
}


int somatorio(int n)
{
    // Caso base
    if (n == 0)
        return 0; // 0 pq é soma

    // Caso recurssivo
    return n + somatorio(n - 1);
}

long long potencia(int base, int exp){
    // Caso Base
    if(exp == 0) return 1;

    // Caso Recurssivo
    return base * potencia(base, exp - 1);
}

int somaVetor(int v[], int n){
    // Condição Base
    if(n==0){
        return 0;
    }

    // Caso recurssivo - indice n-1 , ja que tem 3 indices (0, 1, 2, 3) e 4 elementos (1, 2, 3, 4)
    return v[n-1] + somaVetor(v, n-1);

}

int maiorElemento(int v[], int n){
    // Caso Base
    if (n == 1) return v[0];

    int anterior = maiorElemento(v, n-1);
    if (v[n - 1] > anterior)
        return v[n - 1];
   
    return anterior;
}

